# Local demonstration. Replace this internal shared secret for deployment.
INTERNAL_SERVICE_KEY=sentinel-local-demo-change-before-deploy
SENTINEL_ENV=development
AI_ENGINE_URL=http://ai-engine:8002
AI_ENGINE_TIMEOUT_SECONDS=40
AI_DEMO_FALLBACK=true
# Gemini is the supported provider; LLM_API_KEY is an alias for a Gemini key.
GEMINI_API_KEY=
LLM_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
DATABASE_URL=postgresql+psycopg://sentinel:sentinel_dev_password@db:5432/sentinel_db
POSTGRES_PASSWORD=sentinel_dev_password
VITE_API_BASE_URL=http://localhost:8001
